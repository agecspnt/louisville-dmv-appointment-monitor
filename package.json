{
  "name": "dmv-appointment-monitor-electron",
  "version": "1.0.3",
  "description": "Desktop monitor for Kentucky DMV appointment availability (Electron + Playwright)",
  "main": "electron/main.js",
  "author": "DMV Appointment Monitor contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "electron",
    "playwright",
    "dmv",
    "appointment-monitor",
    "desktop-app"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "install:browsers": "node scripts/install-playwright-hermetic.mjs",
    "test": "node --test",
    "test:live": "node --test tests/live.integration.test.js",
    "build:win": "npm run install:browsers && npm test && electron-builder --publish never --win nsis portable",
    "build:all": "node scripts/build-all.mjs"
  },
  "build": {
    "appId": "com.local.dmv.monitor",
    "productName": "DMV Appointment Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "!node_modules/**/.local-browsers/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "ms-playwright"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "playwright": "^1.53.1"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8"
  }
}
